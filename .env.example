# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Maps API Key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Payment Gateway (legacy / unused — kept for reference)
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Cashfree Payment Gateway
# Set CASHFREE_ENV to "sandbox" or "production"
EXPO_PUBLIC_CASHFREE_APP_ID=your_cashfree_app_id_here
EXPO_PUBLIC_CASHFREE_ENV=sandbox
# Server-only (set as Supabase function secret, NEVER prefix with EXPO_PUBLIC_)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here
CASHFREE_ENV=sandbox

# AI — server-only secrets (set as Supabase function secrets, NEVER prefix with EXPO_PUBLIC_)
# Gemini powers the photo/text diagnosis (supabase/functions/diagnose).
GEMINI_API_KEY=your_gemini_api_key_here
# Groq powers Whisper transcription and the interview/verify functions.
GROQ_API_KEY=your_groq_api_key_here